# The same DashScope key is used by the realtime frontend and qwen-plus backend.
DASHSCOPE_API_KEY=
# DeepSeek Harness native web_search uses this key separately from qwen-plus.
DEEPSEEK_API_KEY=
# Amap Web Service keys: v3 geocoding/reverse geocoding and v5 nearby POI search.
AMAP_V3_API_KEY=
AMAP_V5_API_KEY=
QWEN_AUDIO_REALTIME_PROVIDER=dashscope
QWEN_AUDIO_REALTIME_MODEL=qwen3.8-omni-flash-realtime
# Qwen3.8 requires a workspace-specific endpoint in the matching region.
QWEN_AUDIO_REALTIME_BASE_URL=
QWEN_OMNI_REALTIME_VOICE=Tina

# Optional: connect the shared page to an already running MiniCPM-o service.
# No MiniCPM model or weights are downloaded by this Qwen/Gateway project.
MINICPM_O_REALTIME_URL=
MINICPM_O_AUTH_TOKEN=

# DeepSeek Harness runs behind the qwen-audio-agent Gateway via native ACP.
AGENT_PROTOCOL=deepseek
QWEN_AUDIO_AGENT_BACKEND_MODEL=qwen-plus
QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native

# Search belongs to the DeepSeek Harness background task, not the frontend's
# unauthenticated fallback web-search provider.
QWEN_AUDIO_WEB_TOOLS_ENABLED=0
