+    async _waitForVideoReady(stream, timeoutMs = 8000) {
+        const video = this._videoEl;
+        const track = stream?.getVideoTracks?.()[0];
+        if (!video || !track || track.readyState !== 'live') {
+            throw new Error('Camera track is not live');
+        }
+
+        video.muted = true;
+        video.playsInline = true;
+        await new Promise((resolve, reject) => {
+            let timer = null;
+            const cleanup = () => {
+                if (timer) clearTimeout(timer);
+                video.removeEventListener('loadedmetadata', onReady);
+                video.removeEventListener('canplay', onReady);
+                video.removeEventListener('error', onError);
+            };
+            const onReady = () => {
+                if (video.videoWidth > 0 && video.videoHeight > 0 && video.readyState >= 2) {
+                    cleanup();
+                    resolve();
+                }
+            };
+            const onError = () => {
+                cleanup();
+                reject(new Error('Camera preview failed to load'));
+            };
+            timer = setTimeout(() => {
+                cleanup();
+                reject(new Error('Timed out waiting for the first camera frame'));
+            }, timeoutMs);
+            video.addEventListener('loadedmetadata', onReady);
+            video.addEventListener('canplay', onReady);
+            video.addEventListener('error', onError, { once: true });
+            onReady();
+        });
+
+        // Explicit playback is needed when a preview stream becomes a live session.
+        await video.play();
+        if (typeof video.requestVideoFrameCallback === 'function') {
+            await new Promise((resolve, reject) => {
+                const timer = setTimeout(
+                    () => reject(new Error('Camera opened but did not present a video frame')),
+                    4000,
+                );
+                video.requestVideoFrameCallback(() => {
+                    clearTimeout(timer);
+                    resolve();
+                });
+            });
+        } else {
+            await new Promise(resolve => setTimeout(resolve, 200));
+        }
+    }
